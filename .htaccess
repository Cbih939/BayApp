Options -Indexes
DirectoryIndex index.php

# Bloqueia arquivos sensíveis
<FilesMatch "^(config\.php|config\.sample\.php|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>

# Segurança básica
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# O redirecionamento para HTTPS é feito pelo app (src/security.php). Para desligar: 'force_https' => false no config.php.

# CSS/JS sempre revalidados (a URL já muda com o conteúdo): evita visual antigo depois de atualizar
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
